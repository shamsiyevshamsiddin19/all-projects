# App Settings
APP_NAME=Teacher-Student Task Management API
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=tracker_super_secret_jwt_key_development_only_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
# For local development, default to async sqlite (or postgresql+asyncpg://user:pass@localhost:5432/tracker_db)
DATABASE_URL=sqlite+aiosqlite:///./tracker.db

# Storage Settings
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Settings (comma-separated origins)
CORS_ORIGINS=["*"]
