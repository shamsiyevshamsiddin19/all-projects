# === Boostday bot konfiguratsiyasi ===
# Bu faylni `.env` deb nusxalang va o'z qiymatlaringiz bilan to'ldiring.
# `.env` HECH QACHON git'ga qo'shilmasin (.gitignore'da bor).

# --- Telegram ---
# @BotFather'dan olingan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Botingiz useri (@ belgisisiz)
BOT_USERNAME=mening_botim
# Bot ID — token ichidagi ":" belgisidan oldingi raqam
BOT_ID=123456789
# Bot egasi/adminlar Telegram ID'lari (vergul bilan): masalan 111111111,222222222
# O'z ID'ingizni @userinfobot orqali bilib olasiz
BOT_ADMIN_IDS=
# Webhook uchun maxfiy kalit (ixtiyoriy, lekin tavsiya etiladi):
#   openssl rand -hex 32
WEBHOOK_SECRET=

# Telegram Mini App sahifasi manzili (o'z domeningiz)
MINIAPP_URL=https://example.com/boost/app
# Web App (kunlik reja) sahifasi manzili
WEB_APP_URL=https://example.com/index.html?section=day

# Sayt backend initData'siz murojaat qilganda ishlatiladigan maxfiy kalit.
# Sayt tomonidagi BOOST_SITE_SECRET bilan BIR XIL bo'lishi shart:
#   openssl rand -hex 32
SITE_SECRET=

# Vaqt mintaqasi (IANA formati): Asia/Tashkent, Europe/Moscow, UTC ...
TIMEZONE=Asia/Tashkent

# --- Baza (PostgreSQL — sayt backend'idagi DB_* bilan BIR XIL bo'lishi kerak) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yordamchi
DB_USER=yordamchi
DB_PASS=
