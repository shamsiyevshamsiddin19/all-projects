msgid "Shaxsiy sayt yoki portfolio"
msgstr "Personal website or portfolio"

msgid ""
"Skript yoki AI agent sizning nomingizdan mahsulot qo'shishi, tahrirlashi va "
"sotuv statistikasini o'qishi uchun."
msgstr ""
"For a script or AI agent that adds and edits products on your behalf and "
"reads sales statistics."

msgid "Sotuv tahlili"
msgstr "Sales analytics"

msgid "Sotuvchi anketasini to'ldiring va loyihalaringizni sotuvga qo'ying."
msgstr "Fill in the seller form and list your projects for sale."

msgid "Sotuvchi bo'lgan sana"
msgstr "Date became a seller"

msgid "Sotuvchi bo'limi"
msgstr "Seller section"

msgid "Sotuvchi bo'lish"
msgstr "Become a seller"

msgid "Sotuvchi bo'lish — wstore.uz"
msgstr "Become a seller — wstore.uz"

msgid ""
"Sotuvchi paneli va API kaliti ochiladi. Har bir yangi loyiha uchun bir "
"martalik %(fee)s so'm e'lon to'lovi olinadi, so'ng moderatsiyadan o'tadi."
msgstr ""
"The seller panel and API key will unlock. Each new project has a one-time "
"listing fee of %(fee)s UZS, then goes through moderation."

msgid "Sotuvchi panelini ko'rish uchun tizimga kiring"
msgstr "Sign in to view the seller panel"

msgid "Sotuvchi shartlariga roziman"
msgstr "I agree to the seller terms"

msgid ""
"Sotuvchi shartlariga roziman: faqat o'zimga tegishli, qonuniy kontent "
"joylashtiraman."
msgstr ""
"I agree to the terms: I will only list legal content that belongs to me."

msgid "Sotuvdan tushgan mablag' shu kartaga yechib beriladi."
msgstr "Earnings from sales will be withdrawn to this card."

msgid "Sotuvdan tushgan mablag' shu kartaga yechiladi"
msgstr "Earnings from sales are withdrawn to this card"

msgid "Sotuvlar"
msgstr "Sales"

msgid "Tabriklaymiz! Endi siz sotuvchisiz — birinchi loyihangizni qo'shing."
msgstr "Congratulations! You're now a seller — add your first project."

msgid "Tasdiqlangan sotuvchi"
msgstr "Verified seller"

msgid "Tasdiqlangan xarid"
msgstr "Verified purchase"

msgid ""
"Telegram username majburiy — xaridorlar siz bilan shu orqali bog'lanadi."
msgstr "Telegram username is required — buyers will contact you through it."

msgid "Tizimga kirish"
msgstr "Sign in"

msgid "To'g'ri email manzil kiriting."
msgstr "Please enter a valid email address."

msgid "Username yoki emailingiz"
msgstr "Your username or email"

msgid "Ushbu mahsulot haqida fikringizni bildiring"
msgstr "Share your thoughts on this product"

msgid "Xarid qilingan loyihalar va manba kodlari."
msgstr "Purchased projects and source code."

msgid "Xaridlar"
msgstr "Purchases"

msgid ""
"Xaridlaringiz, yuklab olish tokenlari va referal havolangizni ko'rish uchun "
"hisobingizga kiring."
msgstr "Sign in to view your purchases, download tokens and referral link."

msgid "Xaridorlar siz bilan shu orqali bog'lanadi"
msgstr "Buyers will contact you through this"

msgid "Yangi hisob yaratish"
msgstr "Create a new account"

msgid "Yangi kalit yaratish"
msgstr "Create a new key"

msgid ""
"Yangi mahsulot DRAFT holatida yaratiladi — e'lon to'lovi va moderatsiya "
"saytdagi oddiy tartibda o'tadi."
msgstr ""
"A new product is created as DRAFT — the listing fee and moderation follow "
"the site's normal process."

msgid "Yangi mahsulot qo'shish"
msgstr "Add a new product"

msgid "Yaratilgan"
msgstr "Created"

msgid "Yaratish"
msgstr "Create"

msgid "Yuklab olishlar soni"
msgstr "Download count"

msgid "kalit egasi"
msgstr "key owner"

msgid "kategoriyalar ro'yxati"
msgstr "list of categories"

msgid "sotuv tahlili"
msgstr "sales analytics"

msgid "wstore.uz raqamli bozorida hisob yarating."
msgstr "Create an account on the wstore.uz digital marketplace."

msgid "wstore.uz raqamli bozoriga kiring."
msgstr "Sign in to the wstore.uz digital marketplace."

msgid "yoki boshqa hisob kiriting"
msgstr "or sign in with another account"

msgid "yoki forma orqali"
msgstr "or via the form"

msgid "yoki login va parol bilan"
msgstr "or with username and password"

msgid "«%(name)s» kaliti bekor qilindi."
msgstr "Key «%(name)s» has been revoked."

msgid "«%(title)s» butunlay o'chirildi."
msgstr "«%(title)s» has been permanently deleted."

msgid ""
"«%(title)s» do'kondan olib tashlandi (arxivlandi). Oldin sotib olgan "
"xaridorlar o'z kabinetida yuklab olishda davom etishadi."
msgstr ""
"«%(title)s» has been removed from the store (archived). Buyers who purchased"
" it earlier can still download it from their dashboard."

msgid "«@» belgisiz yozing. Xaridorlar loyiha sahifasidan shu orqali yozadi."
msgstr ""
"Enter without the «@» symbol. Buyers will message you through it from the "
"project page."

msgid "Onlayn xarid hozircha mavjud emas. Sotuvchi bilan bog'laning."
msgstr "Online purchasing is not available yet. Contact the seller."

msgid "Loyiha fayli hozircha mavjud emas. Sotuvchi bilan bog'laning."
msgstr "The project file is currently unavailable. Contact the seller."

msgid "Onlayn to'lov vaqtincha mavjud emas."
msgstr "Online payment is temporarily unavailable."

msgid "Narx musbat son bo'lishi kerak."
msgstr "The price must be greater than zero."

msgid "Faqat ZIP, TAR.GZ yoki RAR arxivini yuklang."
msgstr "Upload a ZIP, TAR.GZ or RAR archive."

msgid "Fayl hajmi %(limit)s baytdan oshmasligi kerak."
msgstr "File size must not exceed %(limit)s bytes."

msgid "Baho 1 dan 5 gacha bo'lishi kerak."
msgstr "The rating must be between 1 and 5."

msgid "Kodni yuklab olish"
msgstr "Download source code"

msgid "Hisob faol emas."
msgstr "This account is inactive."
