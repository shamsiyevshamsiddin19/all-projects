# ---- Asosiy ----
# Prod'da ALBATTA o'zgartiring: DEBUG=False bo'lsa standart kalit bilan
# loyiha umuman ishga tushmaydi (settings.py tekshiradi).
SECRET_KEY="bu-yerga-uzun-tasodifiy-satr"
DEBUG=False
ALLOWED_HOSTS="wstore.uz,www.wstore.uz"
APP_URL="https://wstore.uz"

# DEMO_MODE — "Tezkor demo kirish" va "simulyatsiya qilingan to'lov"ni yoqadi.
# Bular mahsulotni BEPUL beradi va admin hisobiga kirishga ruxsat beradi,
# shuning uchun prod'da HAR DOIM False bo'lishi kerak.
# Berilmasa, DEBUG qiymatini oladi.
DEMO_MODE=False

# ---- Baza ----
# Bo'sh qoldirilsa SQLite (db.sqlite3) ishlatiladi.
DATABASE_URL="postgresql://wstore:parol@localhost:5432/wstore"

# ---- Biznes sozlamalari ----
UZS_RATE=12600
LISTING_FEE_SOM=5000
MIN_WITHDRAWAL_SOM=50000
REFERRAL_BONUS_SOM=10000
PLATFORM_COMMISSION_PERCENT=0

# ---- Click to'lov ----
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_BRIDGE_SECRET="php-ko'prik bilan bir xil bo'lishi shart"

# ---- Google bilan kirish (saytdagi YAGONA kirish usuli) ----
# https://console.cloud.google.com/ -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application
#
# Authorized redirect URIs ga qo'shing:
#   http://127.0.0.1:8042/auth/google/callback/   (lokal)
#   https://wstore.uz/auth/google/callback/       (prod)
#
# Ikkalasi bo'sh qolsa — tugma sahifada umuman ko'rsatilmaydi.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Odatda bo'sh qoldiriladi (so'rov manzilidan yasaladi). nginx orqasida
# domen/sxema boshqacha ko'rinsa — shu yerda aniq yozing.
GOOGLE_OAUTH_REDIRECT_URI=""

# Sayt egalari: shu Google emaillari bilan kirgan foydalanuvchi avtomatik
# admin bo'ladi. BUSIZ hech kim admin bo'la olmaydi — saytga faqat Google
# orqali kiriladi, parolli kirish yo'q. Vergul bilan ajratiladi.
ADMIN_EMAILS="siz@gmail.com"

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
