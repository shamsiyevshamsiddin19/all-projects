# === Yordamchi backend konfiguratsiyasi ===
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring. .env ni HECH QACHON git'ga qo'ymang.

# --- Baza (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yordamchi
DB_USER=yordamchi
DB_PASS=CHANGE_ME

# --- Sessiya / xavfsizlik ---
# Majburiy! Yarating:  openssl rand -hex 32
SESSION_SECRET=
SESSION_HTTPS_ONLY=true
# Bu ilova login talab qilmaydi (hamma umumiy fazoda ishlaydi). false qoldiring.
REQUIRE_AUTH=false

# --- Rejim ---
APP_DEBUG=false

# --- Statik frontend ---
# nginx statikani tarqatsa: false. FastAPI o'zi tarqatsa: true.
SERVE_STATIC=false
# PHP loyihaning ildizi (index.html, assets/, uploads/ shu yerda). Default: backend_py ning ota-papkasi.
# FRONTEND_ROOT=/var/www/yordamchi

# --- CORS (bir domen bo'lsa bo'sh qoldiring) ---
CORS_ORIGINS=

# --- Login rate-limit ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
