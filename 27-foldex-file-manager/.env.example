# ==============================================================================
# FOLDEX: Telegram File Manager Bot + Web Admin Panel
# Muhit o'zgaruvchilari namunasi (.env.example)
# ==============================================================================

# Ilova sozlamalari
PROJECT_NAME="Foldex File Manager"
ENVIRONMENT="production"
DEBUG=false
DOMAIN="https://foldex.shamsiyev.uz"
HOST="0.0.0.0"
PORT=8000

# Telegram Bot sozlamalari
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_ADMIN_ID=7883409434
# Webhook uchun maxfiy kalit (Telegramdan keluvchi so'rovlarni tekshirish uchun)
WEBHOOK_SECRET="generate_random_secret_string_for_webhook"
USE_WEBHOOK=true

# Xavfsizlik va JWT autentifikatsiyasi
JWT_SECRET_KEY="super_secret_jwt_random_key_change_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# PostgreSQL ma'lumotlar bazasi
# Docker compose ichida: postgres:5432
# Mahalliy muhitda: localhost:5432
POSTGRES_USER="foldex_user"
POSTGRES_PASSWORD="secure_foldex_db_password"
POSTGRES_DB="foldex_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432

DATABASE_URL="postgresql+asyncpg://foldex_user:secure_foldex_db_password@postgres:5432/foldex_db"
SYNC_DATABASE_URL="postgresql://foldex_user:secure_foldex_db_password@postgres:5432/foldex_db"

# Fayllarni saqlash sozlamalari
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=500
