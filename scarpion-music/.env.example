# Bu FAQAT namuna. Nusxa oling:  cp .env.example .env
# Keyin .env ni to'ldiring. .env git'ga TUSHMAYDI (.gitignore da bor).

# --- Django ---
# Serverga chiqarishdan oldin yangisini yarating:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=

# --- PostgreSQL ---
# DB_NAME bo'sh bo'lsa loyiha SQLite bilan ishlaydi.
# To'ldirsangiz - avtomatik PostgreSQL ga o'tadi.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Spotify ---
# https://developer.spotify.com/dashboard -> Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Musiqa xizmati ---
# deezer  = kalit kerak emas, bepul, darhol ishlaydi
# spotify = yuqoridagi kalitlar + ilova egasida Premium bo'lishi SHART
MUSIC_PROVIDER=deezer

# --- Ijrochi rasmlari (TheAudioDB) ---
# Ochiq test kaliti "2" bilan ham ishlaydi, bo'sh qoldirsa bo'ladi.
AUDIODB_KEY=

# --- Firebase (Google orqali kirish) ---
# https://console.firebase.google.com -> Project settings -> Your apps
# Bu kalitlar maxfiy emas, brauzerga beriladi.
# Ishlashi uchun Firebase konsolida:
#   1. Authentication -> Sign-in method -> Google yoqilgan bo'lsin
#   2. Authentication -> Settings -> Authorized domains ga
#      localhost va 127.0.0.1 qo'shilgan bo'lsin
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
