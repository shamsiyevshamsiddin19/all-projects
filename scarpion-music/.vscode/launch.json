{
  // VS Code da F5 bosilganda ishlaydigan sozlamalar.
  // Ishlashi uchun "Python" kengaytmasi o'rnatilgan bo'lishi kerak.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: serverni ishga tushirish",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8000"],
      // django: true -> shablonlarga ham to'xtash nuqtasi qo'yish mumkin
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Django: tarmoqqa ochiq (telefondan ham)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Django: albomlarni yuklash",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["seed_albums"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
