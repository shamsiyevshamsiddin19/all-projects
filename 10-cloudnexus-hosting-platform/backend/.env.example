# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Subdomenlar shu domendan beriladi: <slug>.whost.uz
PLATFORM_DOMAIN=whost.uz

# --- Database ---
# Bo'sh qoldirilsa SQLite ishlatiladi (dev uchun yetarli)
# DATABASE_URL=postgres://nexcloud:nexcloud@localhost:5432/nexcloud

# --- OAuth ---
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: http://localhost:8000/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
