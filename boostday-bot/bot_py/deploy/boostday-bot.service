[Unit]
Description=Boostday Telegram bot (FastAPI webhook)
After=network.target postgresql.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/yordamchi/Boostdaybot/bot_py
EnvironmentFile=/opt/yordamchi/Boostdaybot/bot_py/.env
ExecStart=/opt/yordamchi/Boostdaybot/bot_py/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker --workers 1 --bind 127.0.0.1:8090 --timeout 60 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
