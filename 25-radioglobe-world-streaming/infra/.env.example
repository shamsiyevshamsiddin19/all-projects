# infra/.env — bu faylni nusxalab .env nomi bilan saqlang va to'ldiring.
# .env hech qachon git'ga tushmaydi.

ENVIRONMENT=production

# --- Ma'lumotlar bazasi ---
POSTGRES_DB=radioglobe
POSTGRES_USER=radioglobe
# Yaratish: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Redis ---
# Yaratish: openssl rand -base64 32
REDIS_PASSWORD=

# --- Proxy imzo kaliti (MAJBURIY, kamida 32 belgi) ---
# Yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SECRET_KEY=

# --- Ommaviy manzillar ---
PUBLIC_SITE_URL=https://radio.shamsiyev.uz
PROXY_BASE_URL=https://radio.shamsiyev.uz/api/v1/stream
NEXT_PUBLIC_API_URL=https://radio.shamsiyev.uz/api/v1

# --- Deploydan keyin keshni yangilash kaliti ---
# Yaratish: openssl rand -hex 24
REVALIDATE_SECRET=

# --- Worker jadvali ---
INGEST_INTERVAL_HOURS=24
HEALTH_CHECK_INTERVAL_MINUTES=10
HEALTH_CHECK_BATCH=300
