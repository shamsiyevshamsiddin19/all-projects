# === Yordamchi backend konfiguratsiyasi ===
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring. .env ni HECH QACHON git'ga qo'ymang.

# --- Baza (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yordamchi
DB_USER=yordamchi
DB_PASS=CHANGE_ME

# --- Sessiya / xavfsizlik ---
# Majburiy! Yarating:  openssl rand -hex 32
SESSION_SECRET=
SESSION_HTTPS_ONLY=true
# Bu ilova login talab qilmaydi (hamma umumiy fazoda ishlaydi). false qoldiring.
REQUIRE_AUTH=false

# --- Rejim ---
APP_DEBUG=false

# --- Statik frontend ---
# nginx statikani tarqatsa: false. FastAPI o'zi tarqatsa: true.
SERVE_STATIC=false
# PHP loyihaning ildizi (index.html, assets/, uploads/ shu yerda). Default: backend_py ning ota-papkasi.
# FRONTEND_ROOT=/var/www/yordamchi

# --- CORS (bir domen bo'lsa bo'sh qoldiring) ---
CORS_ORIGINS=

# --- Login rate-limit ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# === Kirish (2026-08-29 dan) ===
# AUTH_MODE=google  -> parol bilan kirish va ro'yxatdan o'tish YOPILADI,
#                      faqat Google ID token bilan kiriladi.
# AUTH_MODE=password-> eski holat (email + parol).
AUTH_MODE=password

# Google Cloud Console -> Credentials -> OAuth 2.0 Web application client ID.
# Kelgan token'ning `aud` maydoni AYNAN shunga teng bo'lishi shart, aks holda
# boshqa saytga berilgan token bilan ham kirib bo'lardi.
# Bu MAXFIY EMAS — u baribir sahifa kodida ochiq turadi.
GOOGLE_CLIENT_ID=

# Kirishga ruxsat etilgan emaillar (vergul bilan).
# BO'SH BO'LSA HECH KIM kira olmaydi — ataylab shunday: ro'yxat noto'g'ri
# sozlansa, sayt ochilib qolgandan ko'ra yopilib qolgani xavfsizroq.
ALLOWED_EMAILS=

# Yozuv VA o'qish uchun login talab qilinsinmi (production'da true)
# REQUIRE_AUTH yuqorida
